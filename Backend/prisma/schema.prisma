generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CVHistory {
  id        Int      @id
  text      String
  analysis  Json
  createdAt DateTime @default(now())
}

model InterviewHistory {
  id        String   @id @default(uuid())
  role      String
  questions Json
  feedback  Json
  createdAt DateTime @default(now())
}

model SkillGapHistory {
  id        String   @id @default(uuid())
  role      String
  skills    Json
  gap       Json
  createdAt DateTime @default(now())
}
